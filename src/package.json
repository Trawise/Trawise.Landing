    "accommodation",
    "mobile-app",
    "landing-page",
    "react",
    "vite"
  ],
  "homepage": "https://trawise.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/Trawise/Trawise.Landing.git"
  },
